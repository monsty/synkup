# Copier en .env et renseigner. Jamais de secret commité.
NODE_ENV=development
PORT=3000
# Postgres local : `docker compose up -d` (voir docker-compose.yml). Prisma lit cette variable.
DATABASE_URL="postgresql://synkup:synkup@localhost:5432/synkup?schema=public"
# Clé secrète Clerk (instance de développement) : `clerk env pull` ou tableau de bord.
CLERK_SECRET_KEY=
