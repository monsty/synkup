# Copier en .env et renseigner. Jamais de secret commité.
NODE_ENV=development
PORT=3000
# Postgres local : `docker compose up -d` (voir docker-compose.yml). Prisma lit cette variable.
DATABASE_URL="postgresql://synkup:synkup@localhost:5432/synkup?schema=public"
# Jetons `dev:<id>:<email>` pour tester au curl sans l'app. Désactivés si absent, interdits en
# production (le serveur refuse de démarrer).
ALLOW_DEV_TOKENS=false
# Clé secrète Clerk (instance de développement) : `clerk env pull` ou tableau de bord.
CLERK_SECRET_KEY=
# Début des liens d'invitation (contenu des QR codes). Par défaut https://synkup.app/join/
INVITE_BASE_URL=https://synkup.app/join/
# Bucket des médias, S3 compatible (Backblaze B2, région EU). Bucket privé, clé limitée à ce
# bucket en lecture/écriture. Endpoint avec ou sans https://.
S3_ENDPOINT=s3.eu-central-003.backblazeb2.com
S3_REGION=eu-central-003
S3_BUCKET=synkup-medias-dev
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
